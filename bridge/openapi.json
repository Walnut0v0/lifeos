{
  "openapi": "3.1.0",
  "info": {
    "title": "Private LifeOS Focus Exchange",
    "version": "1.0.0",
    "description": "Authenticated personal plan publication and optional usage feedback. Never reads ChatGPT messages."
  },
  "servers": [
    {
      "url": "https://YOUR-PRIVATE-EXCHANGE.invalid"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ScheduleSnapshot": {
        "type": "object",
        "required": [
          "schema_version",
          "revision",
          "generated_at",
          "timezone",
          "valid_until",
          "tasks"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "type": "string"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "tasks": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "required": [
                "task_id",
                "start_at",
                "end_at",
                "focus_mode"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,80}$"
                },
                "title": {
                  "type": "string",
                  "maxLength": 120
                },
                "start_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "end_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "focus_mode": {
                  "type": "string",
                  "enum": [
                    "focus",
                    "free"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/v1/plan": {
      "get": {
        "operationId": "getSchedule",
        "summary": "Read current complete plan and revision",
        "responses": {
          "200": {
            "description": "Complete schedule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleSnapshot"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "publishSchedule",
        "summary": "Atomically publish a complete higher revision plan; empty tasks cancels the plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleSnapshot"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict; read current plan before retrying"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "operationId": "getUsageSummary",
        "summary": "Read optional uploaded daily metadata; no screen or message content",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/intervals": {
      "get": {
        "operationId": "getUsageIntervals",
        "summary": "Read authorized detailed metadata, paginated, if enabled by the user",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}